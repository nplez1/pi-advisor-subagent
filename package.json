{
	"name": "rpiv-advisor-subagent",
	"version": "0.1.0",
	"private": true,
	"description": "Local rpiv-advisor fork that runs reviews as visible pi-subagents agents.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"rpiv",
		"advisor"
	],
	"type": "module",
	"license": "MIT",
	"author": "juicesharp",
	"repository": {
		"type": "git",
		"url": "https://github.com/juicesharp/rpiv-mono"
	},
	"scripts": {
		"test": "node --experimental-strip-types --import ./test/register-resolve-ts.mjs --test test/*.test.mjs"
	},
	"files": [
		"index.ts",
		"advisor/",
		"prompts/",
		"agents/",
		"docs/",
		"!docs/*.png",
		"!docs/*.jpg",
		"!docs/*.svg",
		"README.md",
		"LICENSE",
		"!**/*.test.ts"
	],
	"pi": {
		"image": "https://raw.githubusercontent.com/juicesharp/rpiv-mono/main/packages/rpiv-advisor/docs/cover.png",
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "^2.11.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"typebox": "^1.1.24"
	}
}
